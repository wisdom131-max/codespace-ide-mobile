<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CodeSpace.Starting" parent="Theme.SplashScreen">
        <!-- Deep dark background — no flash, matches app dark theme -->
        <item name="windowSplashScreenBackground">#0A0E2A</item>
        <!-- Use VECTOR drawable — crisp at any resolution, no blur -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <!-- Icon bg matches splash bg — no white circle clash -->
        <item name="windowSplashScreenIconBackgroundColor">#0A0E2A</item>
        <!-- Transition to main theme once app is ready -->
        <item name="postSplashScreenTheme">@style/Theme.CodeSpace</item>
    </style>
</resources>
